generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String         @id @default(cuid())
  email          String         @unique
  username       String         @unique
  password       String
  name           String
  avatar         String?
  gender         Gender         @default(UNISEX)
  birthDate      DateTime?
  createdAt      DateTime       @default(now())
  createdGifts   Gift[]         @relation("GiftCreator")
  playlists      Playlist[]     @relation("PlaylistCreator")
  suggestedGifts PlaylistGift[]
  adminPlaylists Playlist[]     @relation("PlaylistAdmins")
  User_A         User[]         @relation("UserFriends")
  User_B         User[]         @relation("UserFriends")
  hobbies        Hobby[]        @relation("UserHobbies")
  wishlist       Gift[]         @relation("UserWishlist")
}

model Hobby {
  id    String @id @default(cuid())
  name  String @unique
  gifts Gift[] @relation("GiftHobbies")
  users User[] @relation("UserHobbies")
}

model Playlist {
  id              String         @id @default(cuid())
  title           String
  isPublic        Boolean        @default(false)
  accessLevel     AccessLevel    @default(ONLY_HOST)
  giftDate        DateTime?
  creatorId       String
  recipientUserId String?
  recipientName   String
  gender          Gender         @default(UNISEX)
  ageGroup        AgeGroup
  chosenGiftId    String?        @unique
  createdAt       DateTime       @default(now())
  chosenGift      Gift?          @relation("PlaylistChosenGift", fields: [chosenGiftId], references: [id])
  creator         User           @relation("PlaylistCreator", fields: [creatorId], references: [id])
  playlistGifts   PlaylistGift[]
  admins          User[]         @relation("PlaylistAdmins")
}

model PlaylistGift {
  id         String   @id @default(cuid())
  playlistId String
  giftId     String
  addedById  String
  createdAt  DateTime @default(now())
  addedBy    User     @relation(fields: [addedById], references: [id])
  gift       Gift     @relation(fields: [giftId], references: [id], onDelete: Cascade)
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)

  @@unique([playlistId, giftId])
}

model Gift {
  id                String         @id @default(cuid())
  title             String
  description       String
  image             String?
  targetGender      Gender         @default(UNISEX)
  ageGroups         AgeGroup[]
  creatorId         String?
  createdAt         DateTime       @default(now())
  creator           User?          @relation("GiftCreator", fields: [creatorId], references: [id])
  chosenInPlaylists Playlist?      @relation("PlaylistChosenGift")
  inPlaylists       PlaylistGift[]
  hobbies           Hobby[]        @relation("GiftHobbies")
  likedBy           User[]         @relation("UserWishlist")
}

enum Gender {
  MALE
  FEMALE
  UNISEX
}

enum AgeGroup {
  BABY
  TODDLER
  CHILD
  PRE_TEEN
  TEENAGER
  YOUNG_ADULT
  ADULT
  SENIOR
}

enum AccessLevel {
  ONLY_HOST
  ADMINS
  ANYONE
}
